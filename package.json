{
  "name": "@devstroop/react-uikit",
  "version": "1.3.0",
  "description": "Generic React UI primitives for Devstroop web apps — presentational, themeable, project-agnostic.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/main.cjs.js",
  "module": "./dist/main.es.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.es.js",
      "require": "./dist/main.cjs.js"
    },
    "./style.css": "./dist/style.css",
    "./base.css": "./dist/base.css",
    "./tokens.css": "./dist/tokens.css",
    "./utilities.css": "./dist/utilities.css",
    "./themes/zen.css": "./dist/themes/zen.css",
    "./themes/fluent.css": "./dist/themes/fluent.css",
    "./themes/material-3.css": "./dist/themes/material-3.css",
    "./themes/github.css": "./dist/themes/github.css",
    "./themes/material.css": "./dist/themes/material.css",
    "./themes/shadcn.css": "./dist/themes/shadcn.css",
    "./themes/default.css": "./dist/themes/default.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && mkdir -p dist/themes && cp lib/styles/themes/*.css dist/themes/",
    "dev": "vite --config demos/vite.config.ts --port 5199 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demos:build": "vite build --config demos/vite.config.ts",
    "test:e2e": "playwright test",
    "demo:audit": "node scripts/audit-demos.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10",
    "storybook": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-mcp": "^10.6.7",
    "eslint-plugin-storybook": "^10.6.7",
    "@vitest/browser-playwright": "4.1.10",
    "playwright": "latest"
  },
  "dependencies": {
    "dompurify": "^3.4.16"
  }
}
